# Supabase Auth (required for OAuth login with Google/GitHub)
# The app will work locally without these — it uses local auth via Prisma
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL for OAuth redirects
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — uses Neon/Postgres. Local SQLite fallback not supported.
# DATABASE_URL=postgresql://...

# AI Providers (at least one recommended; app tries Groq → OpenAI → Anthropic → Gemini)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Error tracking (Sentry)
# SENTRY_DSN=

# Upstash Redis (required for distributed rate limiting in production)
# Get keys from https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# If unset, the app falls back to an in-memory limiter (single-instance only).
